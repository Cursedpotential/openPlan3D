# Names only. Real values go in Coolify env, never in git.
# Deployment (compose)
BIND_IP=                      # tailnet address the port is published on
HOST_PORT=8480                # host port (a guess, not in any port registry yet)
ORIGIN=                       # full URL clients use, e.g. the tailnet https URL (adapter-node origin check)
# Read by the app today
OPENPLAN3D_AGENT_BRIDGE=      # "1" enables the agent bridge; it still answers loopback clients only (see README)
OPENPLAN3D_MIRROR_DIR=        # set by the compose file to /data/mirror; folder mirror of saved projects
# Set in the compose file, listed for completeness
BODY_SIZE_LIMIT=68M           # upstream value
PUBLIC_ENABLE_ANALYTICS=false # false = do not load the Firebase SDK
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Upstream Firebase features: leave unset (off)
HANDOFF_UPLOADS_ENABLED=      # "true" would enable /api/handoffs uploads
ASSISTANT_SHARES_ENABLED=     # "true" would enable assistant shares
HANDOFF_BUCKET=               # Firebase Storage bucket for the two above
HANDOFF_CORS_ALLOW_LOCAL=     # "true" allows local origins on /api/handoffs
# Planned (stages A and B), not read by any code yet; names are placeholders chosen by stage D
SURREAL_URL=                  # URL of the SurrealDB server
SURREAL_NAMESPACE=            # namespace for this app
SURREAL_DATABASE=             # database for this app
SURREAL_USER=                 # SurrealDB user
SURREAL_PASS=                 # SurrealDB password
MCP_BEARER_TOKEN=             # bearer token for the remote MCP route
